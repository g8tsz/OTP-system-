{
  "name": "otp-system",
  "private": true,
  "version": "1.0.0",
  "description": "OTP verification UI: email step, 6-digit input, resend countdown, and success flow (React + Vite + Tailwind CSS v4).",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/g8tsz/OTP-system-.git"
  },
  "bugs": {
    "url": "https://github.com/g8tsz/OTP-system-/issues"
  },
  "homepage": "https://github.com/g8tsz/OTP-system-#readme",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
